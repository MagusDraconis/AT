@inject IStringLocalizer<App> Loc

<div class="legend mb-3">
    <span class="legend-item"><span class="dot" style="background:#1D4ED8"></span>@Loc["map.legend.foundations"].Value</span>
    <span class="legend-item"><span class="dot" style="background:#06B6D4"></span>@Loc["map.legend.structure"].Value</span>
    <span class="legend-item"><span class="dot" style="background:#22C55E"></span>@Loc["map.legend.information"].Value</span>
    <span class="legend-item"><span class="dot" style="background:#EAB308"></span>@Loc["map.legend.cosmology"].Value</span>
    <span class="legend-item"><span class="dot" style="background:#F97316"></span>@Loc["map.legend.physics"].Value</span>
    <span class="legend-item"><span class="dot" style="background:#A855F7"></span>@Loc["map.legend.correspondence"].Value</span>
</div>
