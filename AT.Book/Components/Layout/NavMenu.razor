@namespace AT.Book.Components.Layout
@using MudBlazor
@using AT.Book.Services
@using AT.Book.Services.Localization
@using Microsoft.Extensions.Localization
@inject ChapterRegistry Book
@inject CultureService Culture
@inject IStringLocalizer<App> Loc

<MudNavMenu Class="px-2 py-3">
    <div class="nav-brand px-3 pb-3">
        <MudText Typo="Typo.subtitle1" Class="fw-bold">@Loc["app.title"]</MudText>
        <MudText Typo="Typo.caption" Class="muted">@Loc["app.subtitle"]</MudText>
    </div>

    <MudNavLink Href="@($"/{Culture.Culture}")" Match="NavLinkMatch.All">
        <i class="bi bi-house-door nav-icon"></i>@Loc["app.title"]
    </MudNavLink>
    <MudNavLink Href="@($"/{Culture.Culture}/chapter/preface")">
        <i class="bi bi-journal-bookmark nav-icon"></i>@Loc["nav.preface"]
    </MudNavLink>

    <MudDivider Class="my-3" />

    <div class="px-3 pb-2">
        <MudText Typo="Typo.caption" Class="text-uppercase fw-bold muted">@Loc["nav.toc"]</MudText>
    </div>

    @foreach (var part in Book.Parts)
    {
        <MudNavGroup Title="@Loc[part.TitleKey]" Expanded="@(part.Id == "foundations")">
            @foreach (var ch in part.Chapters)
            {
                <MudNavLink Href="@($"/{Culture.Culture}/chapter/{ch.Id}")">
                    <span class="theory-nav-part">@ch.Order. @Loc[$"chapter.{ch.Id}.title"]</span>
                </MudNavLink>
            }
        </MudNavGroup>
    }

    <MudDivider Class="my-3" />

    <MudNavLink Href="@($"/{Culture.Culture}/theory-map")">
        <i class="bi bi-map nav-icon"></i>@Loc["nav.theoryMap"]
    </MudNavLink>
    <MudNavLink Href="@($"/{Culture.Culture}/research")">
        <i class="bi bi-diagram-3 nav-icon"></i>@Loc["nav.researchMode"]
    </MudNavLink>
</MudNavMenu>
