@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6">AT.Book</MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined" Class="ms-3">Theory Operating System</MudChip>
        <MudSpacer />
        <MudIconButton Href="/graph" Icon="@Icons.Material.Filled.Hub" Color="Color.Primary" AriaLabel="Theory graph" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Lg" Anchor="Anchor.Left" Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-5 px-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isDark = true;
    private bool _drawerOpen = true;

    private static readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#64B5F6",
            Secondary = "#81C784",
            Tertiary = "#FFB74D",
            Background = "#0E1116",
            Surface = "#151A21",
            AppbarBackground = "#10141B",
            DrawerBackground = "#0C0F14",
            DrawerText = "#E6EDF3",
            DrawerIcon = "#8B949E",
            TextPrimary = "#E6EDF3",
            TextSecondary = "#8B949E"
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
