@inherits LayoutComponentBase
@using MudBlazor
@using AT.Book.Services.Localization
@using Microsoft.Extensions.Localization
@inject CultureService Culture
@inject NavigationManager Nav
@inject IStringLocalizer<App> Loc

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingValue Value="Culture">
    <MudLayout>
        <MudAppBar Elevation="1">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="@ToggleDrawer" />
            <MudText Typo="Typo.h6">@Loc["app.title"]</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined" Class="ms-3 d-none d-sm-flex">@Loc["app.subtitle"]</MudChip>
            <MudSpacer />
            <MudTooltip Text="@Loc["nav.researchMode"]" Placement="Placement.Bottom">
                <MudIconButton Href="@($"/{Culture.Culture}/research")" Icon="@Icons.Material.Filled.Hub" Color="Color.Primary" AriaLabel="@Loc["nav.researchMode"]" />
            </MudTooltip>
            <div class="lang-selector">
                <MudSelect T="string" Value="@Culture.Culture" ValueChanged="@OnLanguageChanged" Dense="true"
                           Variant="Variant.Outlined" Margin="Margin.Dense" AdornmentIcon="@Icons.Material.Filled.Translate">
                    @foreach (var lang in LanguageCatalog.All)
                    {
                        <MudSelectItem Value="@lang.Code">@lang.NativeName</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Lg" Anchor="Anchor.Left" Elevation="1">
            <NavMenu />
        </MudDrawer>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Medium" Class="py-5 px-4 book-container">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</CascadingValue>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isDark = true;
    private bool _drawerOpen = true;

    private static readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#64B5F6",
            Secondary = "#81C784",
            Tertiary = "#FFB74D",
            Background = "#0E1116",
            Surface = "#151A21",
            AppbarBackground = "#10141B",
            DrawerBackground = "#0C0F14",
            DrawerText = "#E6EDF3",
            DrawerIcon = "#8B949E",
            TextPrimary = "#E6EDF3",
            TextSecondary = "#8B949E"
        }
    };

    protected override void OnInitialized()
    {
        // Set culture from the URL segment so the nav and all localizers agree.
        var segment = new Uri(Nav.Uri).AbsolutePath.Split('/', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
        if (segment is "en" or "de")
            Culture.Set(segment);
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void OnLanguageChanged(string code)
    {
        if (!LanguageCatalog.IsSupported(code) || code == Culture.Culture)
            return;
        Nav.NavigateTo(BuildUrl(code), forceLoad: true);
    }

    private string BuildUrl(string code)
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries).ToList();
        if (segments.Count == 0)
            return "/" + code;
        segments[0] = code;
        return "/" + string.Join("/", segments);
    }
}
