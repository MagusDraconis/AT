@page "/timeline"
@using AT.Book.Services
@inject TheoryRegistry Registry
@inject TheoryGraphService Graph

<PageTitle>Timeline · AT.Book</PageTitle>

<h2 class="section-heading">Theory Evolution Timeline</h2>
<p class="muted">The progression of the theory: layers foundation-first, audits by date.</p>

<h3 class="section-heading mt-4">Layer progression</h3>
<MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Alternate" Modifiers="true">
    @foreach (var layer in Graph.Layers)
    {
        <MudTimelineItem Color="Color.Primary" DotStyle="DotStyle.Filled" Size="Size.Small">
            <ItemContent>
                <MudText Typo="Typo.caption" Class="muted">Layer @((int)layer.Layer)</MudText>
                <MudText Typo="Typo.subtitle2" Class="fw-bold">@TheoryGraphService.LayerName(layer.Layer)</MudText>
                <MudText Typo="Typo.body2" Class="muted">@layer.Objects.Count objects</MudText>
            </ItemContent>
        </MudTimelineItem>
    }
</MudTimeline>

<h3 class="section-heading mt-5">Audit history</h3>
<MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Alternate" Modifiers="true">
    @foreach (var audit in Registry.Audits.OrderBy(a => a.Date))
    {
        <MudTimelineItem Color="@ColorFor(audit.Status)" DotStyle="DotStyle.Filled" Size="Size.Small">
            <ItemContent>
                <MudText Typo="Typo.caption" Class="muted">@audit.Date.ToString("yyyy-MM-dd")</MudText>
                <MudText Typo="Typo.subtitle2" Class="fw-bold">@audit.Title</MudText>
                <MudText Typo="Typo.body2" Class="muted">@audit.Result</MudText>
            </ItemContent>
        </MudTimelineItem>
    }
</MudTimeline>

@code {
    private static MudBlazor.Color ColorFor(AuditStatus s) => s switch
    {
        AuditStatus.Passed => MudBlazor.Color.Secondary,
        AuditStatus.Partial => MudBlazor.Color.Warning,
        AuditStatus.Failed => MudBlazor.Color.Error,
        _ => MudBlazor.Color.Default,
    };
}
