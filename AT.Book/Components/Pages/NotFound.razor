@page "/not-found"
@using AT.Book.Services.Localization
@using Microsoft.Extensions.Localization
@inject CultureService Culture
@inject IStringLocalizer<App> Loc

<PageTitle>@($"{Loc["notfound.title"]} · {Loc["app.title"]}")</PageTitle>

<h2 class="section-heading">@Loc["notfound.title"]</h2>
<p class="muted">@Loc["notfound.title"]</p>
<MudButton Href="@($"/{Culture.Culture}")" Variant="Variant.Filled" Color="Color.Primary">@Loc["notfound.back"]</MudButton>
