@page "/"
@page "/{Culture}"
@using AT.Book.Services
@inject ChapterRegistry Book
@inject CultureService CultureState
@inject NavigationManager Nav
@inject IStringLocalizer<App> Loc

<PageTitle>@Loc["app.title"] · @Loc["app.subtitle"]</PageTitle>

<div class="hero">
    <div class="hero-art" aria-hidden="true">
        <ChapterHero Kind="preface" />
    </div>
    <div class="hero-copy">
        <p class="hero-kicker">@Loc["app.subtitle"]</p>
        <h1 class="hero-title">@Loc["home.heroTitle"]</h1>
        <p class="hero-sub">@Loc["home.heroSubtitle"]</p>
        <p class="hero-thesis muted">@Loc["home.thesis"]</p>
        <div class="mt-4">
            <MudButton Href="@($"/{CultureState.Culture}/chapter/preface")" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.AutoStories">
                @Loc["home.beginReading"]
            </MudButton>
        </div>
    </div>
</div>

<div class="intro mt-5">
    <h2 class="section-heading">@Loc["home.introHeading"]</h2>
    <p>@Loc["chapter.preface.summary"]</p>
    <p class="muted">@Loc["home.beginReadingHint"]</p>
</div>

<div class="mt-4">
    <h2 class="section-heading">@Loc["home.whatHeading"]</h2>
    @foreach (var para in Split(Loc["chapter.preface.narrative"]))
    {
        <p>@para</p>
    }
</div>

<div class="mt-4">
    <h2 class="section-heading">@Loc["home.tocHeading"]</h2>

    <MudCard Elevation="0" Class="toc-card mb-3">
        <MudCardContent>
            <MudLink Href="@($"/{CultureState.Culture}/chapter/preface")" Typo="Typo.subtitle1" Class="fw-bold">@Loc["nav.preface"]</MudLink>
            <MudText Typo="Typo.body2" Class="muted">@Loc["chapter.preface.summary"]</MudText>
        </MudCardContent>
    </MudCard>

    @foreach (var part in Book.Parts)
    {
        <MudCard Elevation="0" Class="toc-card mb-3">
            <MudCardContent>
                <MudText Typo="Typo.subtitle1" Class="fw-bold part-title">@Loc[part.TitleKey]</MudText>
                <MudText Typo="Typo.caption" Class="muted">@Loc[part.SubtitleKey]</MudText>
                <div class="toc-chapters mt-2">
                    @foreach (var ch in part.Chapters)
                    {
                        <div class="toc-row">
                            <span class="toc-num muted">@ch.Order</span>
                            <MudLink Href="@($"/{CultureState.Culture}/chapter/{ch.Id}")" Typo="Typo.body2">@Loc[$"chapter.{ch.Id}.title"]</MudLink>
                            <span class="toc-summary muted">@Loc[$"chapter.{ch.Id}.summary"]</span>
                        </div>
                    }
                </div>
            </MudCardContent>
        </MudCard>
    }
</div>

@code {
    [Parameter] public string? Culture { get; set; }

    protected override void OnInitialized()
    {
        if (Culture is "en" or "de")
        {
            CultureState.Set(Culture);
        }
        else
        {
            // Landing at "/" — redirect to the persisted language.
            Nav.NavigateTo($"/{CultureState.Culture}", replace: true);
        }
    }

    private static IEnumerable<string> Split(string text) => text.Split("\n\n", StringSplitOptions.RemoveEmptyEntries);
}
