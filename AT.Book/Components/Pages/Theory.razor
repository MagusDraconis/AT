@page "/theory"
@using AT.Book.Services
@inject TheoryGraphService Graph

<PageTitle>Theory Tree · AT.Book</PageTitle>

<h2 class="section-heading">The Theory Tree</h2>
<p class="muted">Every object, layered foundation-first. Click any object to open its theory page.</p>

@foreach (var layer in Graph.Layers)
{
    <div class="page-section mt-4">
        <h3 class="section-heading">
            Layer @((int)layer.Layer) — @TheoryGraphService.LayerName(layer.Layer)
        </h3>
        <MudGrid Spacing="3">
            @foreach (var o in layer.Objects.OrderBy(x => x.Title))
            {
                <MudItem xs="12" sm="6" lg="4">
                    <ObjectCard Object="@o" />
                </MudItem>
            }
        </MudGrid>
    </div>
}
