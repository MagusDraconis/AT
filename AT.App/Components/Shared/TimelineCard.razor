@namespace AT.App.Components.Shared

<MudCard Elevation="1" Class="timeline-card mb-3">
    <MudCardContent>
        <MudText Typo="Typo.caption" Color="Color.Primary" Class="text-uppercase fw-bold">@Era</MudText>
        <MudText Typo="Typo.subtitle1" Class="fw-bold">@Title</MudText>
        <MudText Typo="Typo.body2" Class="muted">@Description</MudText>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string Era { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
}
