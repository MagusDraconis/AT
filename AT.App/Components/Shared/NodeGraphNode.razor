@namespace AT.App.Components.Shared
@using AT.App.Models

<div class="node-graph-item" style="@($"margin-left: {Depth * 1.25}rem")">
    <div class="node-card" @onclick="() => _expanded = !_expanded">
        <span class="node-caret">@(_expanded ? "▾" : "▸")</span>
        <span class="node-title">@Node.Title</span>
        <ClassificationBadge Kind="@Node.Classification" />
    </div>

    @if (_expanded)
    {
        <div class="node-details">
            <div><strong>Summary.</strong> @Node.Summary</div>
            <div><strong>Classification.</strong> @KindLabel</div>
            <div><strong>Verification.</strong> @Node.VerificationStatus</div>
        </div>
    }

    @foreach (var child in Node.Children)
    {
        <NodeGraphNode Node="child" Depth="@(Depth + 1)" />
    }
</div>

@code {
    [Parameter, EditorRequired] public DerivationNodeModel Node { get; set; } = default!;
    [Parameter] public int Depth { get; set; }

    private bool _expanded;

    private string KindLabel => Node.Classification switch
    {
        ClassificationKind.Derived => "DERIVED",
        ClassificationKind.RealUnderived => "REAL-UNDERIVED",
        ClassificationKind.Drawn => "DRAWN",
        ClassificationKind.Falsified => "FALSIFIED",
        ClassificationKind.Imported => "IMPORTED",
        ClassificationKind.Partial => "PARTIAL",
        ClassificationKind.Emergent => "EMERGENT",
        ClassificationKind.Boundary => "BOUNDARY",
        _ => Node.Classification.ToString().ToUpperInvariant()
    };
}
