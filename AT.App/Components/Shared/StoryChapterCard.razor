@namespace AT.App.Components.Shared

<MudCard Elevation="1" Class="story-card mb-3">
    <MudCardContent>
        <span class="badge @ToneClass"><i class="bi @Icon"></i>&nbsp;@Era</span>
        <MudText Typo="Typo.subtitle1" Class="fw-bold mt-2">@Title</MudText>
        <MudText Typo="Typo.body2" Class="muted">@Description</MudText>
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public string Era { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "";
    [Parameter] public string Tone { get; set; } = "blue";

    private string ToneClass => $"tone-{Tone}";
}
