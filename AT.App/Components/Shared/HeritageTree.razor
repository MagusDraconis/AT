@namespace AT.App.Components.Shared
@using AT.App.Models

<div class="heritage-wrap">
    <svg class="heritage-svg" viewBox="0 0 @Width @Height" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Derivation heritage tree">
        @foreach (var edge in _edges)
        {
            var p = _centers[edge.Parent.Id];
            var c = _centers[edge.Child.Id];
            <path d="@Connector(p.X, p.Y + NodeHeight, c.X, c.Y)" fill="none" stroke="#5A6472" stroke-width="1.6" />
        }

        @foreach (var item in _layout)
        {
            var n = item.Node;
            var center = _centers[n.Id];
            var x = center.X - NodeWidth / 2;
            var y = center.Y;
            <g class="heritage-node" @onclick="() => Select(n)">
                <title>@n.Title — @KindLabel(n.Classification)</title>
                <rect x="@x" y="@y" width="@NodeWidth" height="@NodeHeight" rx="7"
                      fill="@ColorFor(n.Classification)"
                      fill-opacity="@(IsSelected(n) ? 0.34 : 0.16)"
                      stroke="@ColorFor(n.Classification)"
                      stroke-width="@(IsSelected(n) ? 3 : 1.5)" />
                <text x="@center.X" y="@(y + NodeHeight / 2)" text-anchor="middle" dominant-baseline="middle">@n.Title</text>
            </g>
        }
    </svg>
</div>

@if (_selected is not null)
{
    <MudCard Elevation="1" Class="theory-card mt-3">
        <MudCardContent>
            <div class="fw-bold">@_selected.Title</div>
            <ClassificationBadge Kind="@_selected.Classification" />
            <MudText Typo="Typo.body2" Class="muted mt-2"><strong>Summary.</strong> @_selected.Summary</MudText>
            <MudText Typo="Typo.body2" Class="muted"><strong>Verification.</strong> @_selected.VerificationStatus</MudText>
        </MudCardContent>
    </MudCard>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<DerivationNodeModel> Roots { get; set; } = [];

    private const double NodeWidth = 150;
    private const double NodeHeight = 44;
    private const double SlotSpacing = 190;
    private const double LevelSpacing = 92;
    private const double MarginX = 24;
    private const double MarginY = 24;

    private sealed record LayoutItem(DerivationNodeModel Node, double Slot, int Depth);

    private List<LayoutItem> _layout = new();
    private List<(DerivationNodeModel Parent, DerivationNodeModel Child)> _edges = new();
    private Dictionary<string, (double X, double Y)> _centers = new();
    private DerivationNodeModel? _selected;

    private int _nextLeafSlot;
    private int _maxDepth;
    private int _leafCount;

    protected override void OnParametersSet()
    {
        _layout = new List<LayoutItem>();
        _edges = new List<(DerivationNodeModel Parent, DerivationNodeModel Child)>();
        _centers = new Dictionary<string, (double X, double Y)>();
        _nextLeafSlot = 0;
        _maxDepth = 0;

        foreach (var root in Roots)
        {
            LayoutSubtree(root, 0);
        }

        _leafCount = _nextLeafSlot;

        foreach (var item in _layout)
        {
            double cx = MarginX + item.Slot * SlotSpacing + NodeWidth / 2;
            double cy = MarginY + item.Depth * LevelSpacing;
            _centers[item.Node.Id] = (cx, cy);
        }
    }

    private double LayoutSubtree(DerivationNodeModel node, int depth)
    {
        _maxDepth = Math.Max(_maxDepth, depth);

        double slot;
        if (node.Children.Count == 0)
        {
            slot = _nextLeafSlot++;
        }
        else
        {
            double sum = 0;
            foreach (var child in node.Children)
            {
                _edges.Add((node, child));
                sum += LayoutSubtree(child, depth + 1);
            }
            slot = sum / node.Children.Count;
        }

        _layout.Add(new LayoutItem(node, slot, depth));
        return slot;
    }

    private double Width => _leafCount <= 1
        ? NodeWidth + 2 * MarginX
        : (_leafCount - 1) * SlotSpacing + NodeWidth + 2 * MarginX;

    private double Height => _maxDepth * LevelSpacing + NodeHeight + 2 * MarginY;

    private static string Connector(double x1, double y1, double x2, double y2)
    {
        double busY = (y1 + y2) / 2;
        return $"M {x1:F1} {y1:F1} L {x1:F1} {busY:F1} L {x2:F1} {busY:F1} L {x2:F1} {y2:F1}";
    }

    private void Select(DerivationNodeModel node) => _selected = node;

    private bool IsSelected(DerivationNodeModel node) => _selected?.Id == node.Id;

    private static string ColorFor(ClassificationKind k) => k switch
    {
        ClassificationKind.Derived => "#81C784",
        ClassificationKind.RealUnderived => "#FFC107",
        ClassificationKind.Drawn => "#E57373",
        ClassificationKind.Falsified => "#E57373",
        ClassificationKind.Imported => "#90A4AE",
        ClassificationKind.Partial => "#90A4AE",
        _ => "#90A4AE"
    };

    private static string KindLabel(ClassificationKind k) => k switch
    {
        ClassificationKind.Derived => "DERIVED",
        ClassificationKind.RealUnderived => "REAL-UNDERIVED",
        ClassificationKind.Drawn => "DRAWN",
        ClassificationKind.Falsified => "FALSIFIED",
        ClassificationKind.Imported => "IMPORTED",
        ClassificationKind.Partial => "PARTIAL",
        _ => k.ToString().ToUpperInvariant()
    };
}
