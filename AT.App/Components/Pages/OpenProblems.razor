@page "/open-problems"

<PageTitle>Open Problems · AT</PageTitle>

<h2 class="section-heading">Open Problems</h2>
<p class="muted">Genuinely open questions of the AT program — falsifiable predictions awaiting experiment and unresolved derivations. The AT-QG ledger below comes from <span class="mono">Docs/ATQG_PhysicsCoverage.json</span> (single source of truth); the current ResearchY open problems from the V2.2 synthesis are listed after.</p>

@if (_problems is null)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Medium" Class="mt-4" />
}
else if (_problems.Count == 0)
{
    <MudText Typo="Typo.body2" Class="muted">No open problems registered.</MudText>
}
else
{
    <h3 class="section-heading">AT-QG open-questions ledger</h3>
    @foreach (var p in _problems)
    {
        <MudCard Elevation="1" Class="theory-card mb-3">
            <MudCardContent>
                <div class="mb-1">
                    <span class="status-chip @StatusClass(p.Status)">@p.Status</span>
                    <span class="audit-phase ms-2">@p.Phase</span>
                </div>
                <MudText Typo="Typo.subtitle1" Class="fw-bold">@p.Question</MudText>
            </MudCardContent>
        </MudCard>
    }
}

<div class="page-section mt-4">
    <h3 class="section-heading">Current open problems (ResearchY V2.2 — S_001 synthesis)</h3>
    <p class="muted">Open items from the V2.2 geometry-bridge synthesis and the V2.1 origin program — not part of the AT-QG phase ledger.</p>
    @foreach (var p in _v22Problems)
    {
        <MudCard Elevation="1" Class="theory-card mb-3">
            <MudCardContent>
                <div class="mb-1">
                    <span class="status-chip @StatusClass(p.Status)">@p.Status</span>
                    <span class="audit-phase ms-2">@p.Phase</span>
                </div>
                <MudText Typo="Typo.subtitle1" Class="fw-bold">@p.Question</MudText>
            </MudCardContent>
        </MudCard>
    }
</div>

@code {
    [Inject] private ValidationDataService ValidationDataService { get; set; } = default!;

    private IReadOnlyList<OpenQuestionModel>? _problems;

    private static readonly IReadOnlyList<OpenQuestionModel> _v22Problems =
    [
        new("Origin of the discreteness of the actualization tick — the tick (Δθ = 2πk/N) is the final canonical boundary; no deeper principle forcing it has been found.", "QG_011", "OPEN"),
        new("Gauge dynamics — the interaction dynamics IS the D96 generator action, but the Yukawa coupling mechanism is PARTIAL and the Higgs potential is OPEN.", "QG242–244", "PARTIAL"),
        new("Exact neutrino mass law — the structural (neutral-sector) origin is derived; the exact absolute mass law remains open.", "QG172", "OPEN"),
        new("First-peak 5/4 factor — documented FIT (QG297, removable QG289, no mechanism); only ℓ₁ carries it while the peak ratios are pure spectral correspondences.", "QG297", "FIT"),
        new("Bekenstein–Hawking entropy–area relation — not derived in the framework (boundary).", "NP_020", "BOUNDARY"),
        new("Global uniqueness of N=96 — derived within the accepted structural class (period-3 seed, Z2 half-shift, three-family octave window); a proof excluding every conceivable alternative closure remains open.", "D_015", "OPEN"),
        new("Dimensionful units — fixed by the anchors {v, m_e} and standard unit conversion, not derived from the spectrum.", "D_012/D_044", "BOUNDARY"),
        new("Origin of the entangling interaction — the complete minimal quantum extension is {Joint State, Entangling Gate} (NP_038–NP_054), but the entangling gate's physical content (a coherent two-body coupling H_int = J·σ⊗σ, NP_050) is a hosted CORRESPONDENCE, not derivable from canonical D96 (NP_048); why nature selects this specific non-local interaction — and whether it can be anchored to any canonical D96 object — remains open.", "NP_050", "OPEN"),
    ];

    protected override async Task OnInitializedAsync()
    {
        var coverage = await ValidationDataService.GetCoverageAsync();
        _problems = coverage.OpenQuestions;
    }

    private static string StatusClass(string status) => status.ToUpperInvariant() switch
    {
        string s when s.Contains("RESOLVED") => "status-tested",
        string s when s.Contains("PARTIALLY") => "status-partial",
        string s when s.Contains("PREDICTED") || s.Contains("FALSIFIABLE") => "status-partial",
        _ => "status-untested",
    };
}
