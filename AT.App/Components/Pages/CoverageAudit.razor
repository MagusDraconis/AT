        // ── CKM ────────────────────────────────────────────────────────────
        new("CKM |Vus|", CoverageStatus.Tested, "CKM", "QG165", "0.2211", "0.2253", 0.0189, "doublet coupling"),
        new("CKM |Vcb|", CoverageStatus.Tested, "CKM", "QG165", "0.0416", "0.0411", 0.0122, "octave transition"),
        new("CKM |Vub|", CoverageStatus.Tested, "CKM", "QG165", "0.003826", "0.00382", 0.0014, "occupancy suppression"),
        new("CKM δ_CP", CoverageStatus.Tested, "CKM", "QG166", "66.3°", "65.6°", 0.0118, "chiral circulation"),
        new("Jarlskog J", CoverageStatus.Tested, "CKM", "QG166", "3.139e-5", "3.18e-5", 0.0128, "from δ_CP and angles"),
