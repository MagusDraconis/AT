        // ── Neutrino masses ────────────────────────────────────────────────
        new("neutrino masses ν1,ν2,ν3", CoverageStatus.Tested, "Neutrino masses", "QG172", "0, 8.72e-3, 4.94e-2 eV", "normal ordering", 0.0102, "neutral-sector law"),
        new("mass ordering (normal)", CoverageStatus.Tested, "Neutrino masses", "QG172", "m1=0 normal", "normal", null, "normal ordering derived"),
