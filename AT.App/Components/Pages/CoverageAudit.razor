        new("Majorana character", CoverageStatus.Tested, "Neutrino masses", "QG179", "MAJORANA, m_ββ=2.02e-3 eV", "self-conjugate, Q=0", null, "0νββ in reach of next-gen"),

        // ── Precision EW ───────────────────────────────────────────────────
        new("Z width Γ_Z", CoverageStatus.Tested, "Precision EW", "QG175", "2.4953 GeV", "2.4952 GeV", 0.00004, "MH·cosθ_W/#groups"),
        new("W width Γ_W", CoverageStatus.Tested, "Precision EW", "QG175", "2.0852 GeV", "2.085 GeV", 0.0001, "σ_occ²/(occMom·λ₂)"),
        new("Higgs width Γ_H", CoverageStatus.Tested, "Precision EW", "QG175", "4.067 MeV", "4.07 MeV", 0.0008, "λ₂/Σm"),
