        new("R_b, R_c", CoverageStatus.Partial, "Precision EW", "QG175", "R_b 0.2163", "0.2163, 0.1721", 0.0001, "R_b derived; R_c not"),
        new("A_FB, A_POL", CoverageStatus.Partial, "Precision EW", "QG175", "A_FB^b 0.0992", "various", 0.0002, "A_FB derived; A_POL not"),
        new("S, T, U oblique", CoverageStatus.Tested, "Precision EW", "QG180", "S 0.0421, T 0.0842, U 0", "S≈0.04, T≈0.08", 0.053, "T=2S exact"),

        // ── QCD / misc ─────────────────────────────────────────────────────
        new("θ_QCD (strong CP)", CoverageStatus.Tested, "QCD / misc", "QG174", "0 (exactly)", "<1e-10", 0.0, "Z2 reflection suppression"),
        new("quark absolute masses", CoverageStatus.Tested, "QCD / misc", "QG173", "all six", "2.16–172700 MeV", null, "absolute mass law"),
        new("3 generations", CoverageStatus.Tested, "QCD / misc", "QG138", "octave count = 3", "3", null, "fundamental"),
