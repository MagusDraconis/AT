    private static IReadOnlyList<AuditRoadmapItemModel> BuildRoadmap() =>
    [
        new(1, "0νββ (Majorana m_ββ)", "PARTIAL", "derived QG179 (m_ββ=2.02e-3 eV); awaits nEXO/LEGEND-1000"),
        new(2, "electron g-2 (a_e)", "PARTIAL", "derived QG178 (0.0003%); awaits lattice-limited measurement"),
