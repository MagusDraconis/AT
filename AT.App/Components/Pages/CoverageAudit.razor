@page "/coverage-audit"
@using AT.App.Services
@inject ValidationDataService ValidationDataService

<PageTitle>Coverage Audit · AT</PageTitle>

<h2 class="section-heading">Standard Model Coverage Audit</h2>
<p class="muted">Coverage status of the measured Standard Model space, updated through the current physics record. It reports what is tested, partial, or untested; it is not a proof claim.</p>

<!-- ── 1. Overview ───────────────────────────────────────────────────────── -->
<div class="page-section">
    <h3 class="section-heading">1 · Overview</h3>
    <div class="prose">
        <p>
            The audit catalogs the major measured Standard Model quantities and classifies each
            against the current AT derivation record: <strong>tested</strong> (a D96 derivation
            reproduces it), <strong>partial</strong> (a structural origin exists but the quantity is
            not fully reproduced), or <strong>untested</strong> (no derivation yet). The numbers
            below reflect the updated coverage record, including later theory closures and the
            remaining open gaps.
        </p>
    </div>

    <div class="stat-row mb-4">
        <div class="stat-tile">
            <div class="stat-value" style="color:#81C784">@(_tested)/@_total</div>
            <div class="stat-label">Tested</div>
        </div>
        <div class="stat-tile">
            <div class="stat-value" style="color:#FFB74D">@(_partial)/@_total</div>
            <div class="stat-label">Partial</div>
        </div>
        <div class="stat-tile">
            <div class="stat-value" style="color:#E57373">@(_untested)/@_total</div>
            <div class="stat-label">Untested</div>
        </div>
        <div class="stat-tile">
            <div class="stat-value" style="color:#4DD0E1">@(_testedCoverage.ToString("P0", System.Globalization.CultureInfo.InvariantCulture))</div>
            <div class="stat-label">Coverage (tested only)</div>
        </div>
        <div class="stat-tile">
            <div class="stat-value" style="color:#BA68C8">@(_weightedCoverage.ToString("P1", System.Globalization.CultureInfo.InvariantCulture))</div>
            <div class="stat-label">Weighted coverage</div>
        </div>
    </div>

    <MudCard Elevation="1" Class="theory-card">
        <MudCardContent>
            <MudText Typo="Typo.body2" Class="muted">
                Coverage counts how much of the measured SM information space the framework has reached.
                It is a <strong>validation status</strong>, not a proof of correctness: a reproduced
                number is evidence that the derivation is self-consistent, not that the framework is
                the unique or true description of nature. The later hierarchy audits compress the
                explanatory base further, but this page remains a status summary of the measured SM
                coverage record.
            </MudText>
        </MudCardContent>
    </MudCard>
</div>

<!-- ── 2. Tested Observables ─────────────────────────────────────────────── -->
<div class="page-section">
    <h3 class="section-heading">2 · Tested Observables</h3>
    <p class="muted">Quantities with a D96 derivation reproducing the measured value (typically within a few percent).</p>

    <MudTable Items="@_testedItems" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Observable</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Phase</MudTh>
            <MudTh>Derived</MudTh>
            <MudTh>Physical</MudTh>
            <MudTh>Deviation</MudTh>
            <MudTh>Note</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd><span class="audit-cat">@context.Category</span></MudTd>
            <MudTd><span class="audit-phase">@context.Phase</span></MudTd>
            <MudTd><span class="audit-num">@context.Result</span></MudTd>
            <MudTd>@context.Physical</MudTd>
            <MudTd><span class="audit-dev dev-good">@FormatDev(context.DeviationPercent)</span></MudTd>
            <MudTd><span class="muted" style="font-size:0.8rem">@context.Note</span></MudTd>
        </RowTemplate>
    </MudTable>
</div>

<!-- ── 3. Partial Tests ──────────────────────────────────────────────────── -->
<div class="page-section">
    <h3 class="section-heading">3 · Partial Tests</h3>
    <p class="muted">Structural origin exists, but the full quantity is not yet reproduced.</p>

    <MudTable Items="@_partialItems" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Observable</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Phase</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Why partial</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd><span class="audit-cat">@context.Category</span></MudTd>
            <MudTd><span class="audit-phase">@context.Phase</span></MudTd>
            <MudTd><span class="status-chip status-partial">PARTIAL</span></MudTd>
            <MudTd><span class="muted" style="font-size:0.8rem">@context.Note</span></MudTd>
        </RowTemplate>
    </MudTable>
</div>

<!-- ── 4. Untested Observables ───────────────────────────────────────────── -->
<div class="page-section">
    <h3 class="section-heading">4 · Untested Observables</h3>
    <p class="muted">No AT-QG derivation yet — the largest remaining gaps.</p>

    <MudTable Items="@_untestedItems" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Observable</MudTh>
            <MudTh>Category</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Note</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd><span class="audit-cat">@context.Category</span></MudTd>
            <MudTd><span class="status-chip status-untested">UNTESTED</span></MudTd>
            <MudTd><span class="muted" style="font-size:0.8rem">@context.Note</span></MudTd>
        </RowTemplate>
    </MudTable>
</div>

<!-- ── 5. Roadmap ────────────────────────────────────────────────────────── -->
<div class="page-section">
    <h3 class="section-heading">5 · Roadmap</h3>
    <p class="muted">Ranked remaining tests by physics importance and gap size.</p>

    <MudTable Items="@_roadmap" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Rank</MudTh>
            <MudTh>Observable</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Why it matters</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd><span class="audit-rank">@context.Rank</span></MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd><span class="status-chip @StatusClass(context.Status)">@context.Status</span></MudTd>
            <MudTd><span class="muted" style="font-size:0.8rem">@context.Why</span></MudTd>
        </RowTemplate>
    </MudTable>
</div>

<!-- ── 6. Scientific Limitations ─────────────────────────────────────────── -->
<div class="page-section">
    <h3 class="section-heading">6 · Scientific Limitations</h3>
    <MudCard Elevation="1" Class="theory-card">
        <MudCardContent>
            <MudText Typo="Typo.body2" Class="muted">
                This audit records <strong>validation status only</strong>. A tested classification
                means a D96 spectral derivation reproduces the measured value; it does not establish
                that the D96 framework is the correct or unique description of nature. Coverage is not
                proof. The later minimal-theory audits compress the explanation base further, but they
                do not remove the role of this page as a measured-coverage summary. The following
                limitations apply:
            </MudText>
            <ul class="audit-limits mt-2">
                <li><strong>Self-assessment.</strong> The audit is classified against the framework's own
                    derivation record; independent experimental discrimination is needed to confirm any
                    single result.</li>
                <li><strong>Deviation spread.</strong> Some "tested" quantities match within 0.01%, while
                    others carry deviations up to a few percent (e.g. τ mass 2.9%, α_weak @_alphaWeakDev) — coverage
                    counts the reach, not the accuracy of each match.</li>
                <li><strong>Falsifiable predictions remain untested.</strong> The ~106 GeV resonance
                    (QG132) is a sharp, currently-testable prediction that has not yet been observed; a
                    null result would rule out the Z-anchor calibration.</li>
                <li><strong>Experimental validation remains open.</strong> Electron g-2 (a_e), S/T/U oblique
                    parameters, and the neutrino Majorana character are all DERIVED (QG178/180/179) but
                    await experimental validation — the derivations are complete, the experiments are the
                    open item.</li>
                <li><strong>Selection.</strong> The 48 quantities are a major-measured-SM catalog, not an
                    exhaustive list; a different selection would change the coverage percentages.</li>
            </ul>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private readonly IReadOnlyList<AuditItemRow> _all = BuildItems();
    private string _alphaWeakDev = "—";

    private IReadOnlyList<AuditItemRow> _testedItems;
    private IReadOnlyList<AuditItemRow> _partialItems;
    private IReadOnlyList<AuditItemRow> _untestedItems;
    private IReadOnlyList<AuditRoadmapItemModel> _roadmap;

    private int _tested, _partial, _untested, _total;
    private double _testedCoverage, _weightedCoverage;

    protected override void OnInitialized()
    {
        _alphaWeakDev = _all.FirstOrDefault(x => x.Name == "α_weak") is { } alphaWeak && alphaWeak.DeviationPercent.HasValue
            ? (alphaWeak.DeviationPercent.Value * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + "%"
            : "—";

        _testedItems = _all.Where(x => x.Status == CoverageStatus.Tested).ToList();
        _partialItems = _all.Where(x => x.Status == CoverageStatus.Partial).ToList();
        _untestedItems = _all.Where(x => x.Status == CoverageStatus.Untested).ToList();
        _tested = _testedItems.Count;
        _partial = _partialItems.Count;
        _untested = _untestedItems.Count;
        _total = _all.Count;
        _testedCoverage = (double)_tested / (_tested + _untested);
        _weightedCoverage = (double)(_tested + 0.5 * _partial) / _total;
        _roadmap = BuildRoadmap();
    }

    private static string FormatDev(double? dev)
        => dev.HasValue ? (dev.Value * 100).ToString("F2", System.Globalization.CultureInfo.InvariantCulture) + "%" : "—";

    private static string StatusClass(string status) => status switch
    {
        "TESTED" => "status-tested",
        "PARTIAL" => "status-partial",
        _ => "status-untested",
    };

    private sealed record AuditItemRow(
        string Name, CoverageStatus Status, string Category, string Phase, string Result,
        string Physical, double? DeviationPercent, string Note);

    private static IReadOnlyList<AuditItemRow> BuildItems() =>
    [
        // ── Fermion masses ─────────────────────────────────────────────────
        new("electron mass", CoverageStatus.Tested, "Fermion masses", "QG140", "0.51 MeV", "0.511 MeV", 0.002, "lepton hierarchy"),
        new("muon mass", CoverageStatus.Tested, "Fermion masses", "QG140", "105.66 MeV", "105.66 MeV", 0.000, "lepton hierarchy"),
        new("tau mass", CoverageStatus.Tested, "Fermion masses", "QG140", "1828.40 MeV", "1776.86 MeV", 0.029, "lepton hierarchy"),
        new("up quark mass", CoverageStatus.Tested, "Fermion masses", "QG173", "2.164 MeV", "2.16 MeV", 0.0018, "absolute mass law"),
        new("down quark mass", CoverageStatus.Tested, "Fermion masses", "QG173", "4.676 MeV", "4.67 MeV", 0.0014, "absolute mass law"),
        new("strange quark mass", CoverageStatus.Tested, "Fermion masses", "QG173", "93.54 MeV", "93.4 MeV", 0.0015, "absolute mass law"),
        new("charm quark mass", CoverageStatus.Tested, "Fermion masses", "QG173", "1269 MeV", "1270 MeV", 0.0008, "absolute mass law"),
