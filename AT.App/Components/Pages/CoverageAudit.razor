        new("1/α_em", CoverageStatus.Tested, "Couplings", "QG162", "137", "137.036", 0.0003, "fine-structure 137"),
        new("α_weak", CoverageStatus.Tested, "Couplings", "QG162", "0.0316", "0.0338", 0.066, "doublet-transition density"),
