@page "/validation/prediction-status"

<PageTitle>Prediction Status · Validation · AT</PageTitle>

<ValidationHeader />

<div class="page-section">
    <h3 class="section-heading">Prediction Status</h3>
    <p class="muted">
        Live status of every registered prediction, from the outcome dashboard
        (<span class="mono">Docs/ATQG_PredictionOutcomes.json</span>) — the single source of truth for
        external validation. Frozen values never change; only the state advances, and only along the two
        pre-defined paths below.
    </p>

    @if (_outcomes is null)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Medium" Class="mt-4" />
    }
    else
    {
        <MudCard Elevation="1" Class="theory-card mb-4">
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="muted">
                    <span class="status-chip status-tested me-2">IMMUTABLE</span>
                    @_outcomes.Meta.RegistryRule
                </MudText>
            </MudCardContent>
        </MudCard>

        <MudTable Items="_outcomes.Outcomes" Hover="true" Dense="true" Class="mb-4">
            <HeaderContent>
                <MudTh>Prediction</MudTh>
                <MudTh>Frozen value</MudTh>
                <MudTh>Support level</MudTh>
                <MudTh>Last audit</MudTh>
                <MudTh>Next experiment</MudTh>
                <MudTh>State</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><span class="audit-phase me-2">@context.Id</span>@context.Name</MudTd>
                <MudTd>@context.FrozenValue</MudTd>
                <MudTd><span class="muted" style="font-size:0.8rem">@context.SupportLevel</span></MudTd>
                <MudTd><span class="muted" style="font-size:0.8rem">@context.LastAudit</span></MudTd>
                <MudTd><span class="muted" style="font-size:0.8rem">@context.NextExperiment</span></MudTd>
                <MudTd><span class="status-chip @StateClass(context.State)">@context.State</span></MudTd>
            </RowTemplate>
        </MudTable>

        @foreach (var o in _outcomes.Outcomes)
        {
            <div class="page-section">
                <h4 class="section-heading">@o.Id — @o.Name <span class="status-chip @StateClass(o.State)">@o.State</span></h4>
                <MudCard Elevation="1" Class="theory-card">
                    <MudCardContent>
                        <div class="result-row"><span class="result-label">Frozen value</span><span class="result-value">@o.FrozenValue</span></div>
                        <div class="result-row"><span class="result-label">Support level</span><span class="result-value" style="color:#FFB74D">@o.SupportLevel</span></div>
                        <div class="result-row"><span class="result-label">Last audit</span><span class="result-value">@o.LastAudit</span></div>
                        <div class="result-row"><span class="result-label">Next experiment</span><span class="result-value">@o.NextExperiment</span></div>
                        <MudText Typo="Typo.caption" Class="text-uppercase fw-bold muted mt-3 mb-1">Current evidence</MudText>
                        <MudText Typo="Typo.body2" Class="muted">@o.CurrentEvidence</MudText>
                        <MudText Typo="Typo.caption" Class="text-uppercase fw-bold muted mt-3 mb-1">Falsification condition</MudText>
                        <MudText Typo="Typo.body2" Class="muted">@o.Falsification</MudText>
                    </MudCardContent>
                </MudCard>
            </div>
        }

        <MudCard Elevation="1" Class="theory-card">
            <MudCardContent>
                <MudText Typo="Typo.subtitle2" Class="text-uppercase fw-bold muted mb-3">Status paths — never edited, only advanced</MudText>
                <div class="status-path">
                    <div class="status-path-label">Falsifiable path</div>
                    <div class="status-flow">
                        <span class="status-chip status-pending">PENDING</span>
                        <span class="status-arrow">&rarr;</span>
                        <span class="status-chip status-partial">SUPPORTED</span>
                        <span class="status-arrow">&rarr;</span>
                        <span class="status-chip status-tested">CONFIRMED</span>
                    </div>
                </div>
                <div class="status-path">
                    <div class="status-path-label">Falsification path</div>
                    <div class="status-flow">
                        <span class="status-chip status-pending">PENDING</span>
                        <span class="status-arrow">&rarr;</span>
                        <span class="status-chip status-partial">DISFAVORED</span>
                        <span class="status-arrow">&rarr;</span>
                        <span class="status-chip status-untested">FALSIFIED</span>
                    </div>
                </div>
                <MudText Typo="Typo.body2" Class="muted mt-4">
                    A status may only move forward along its own path. No registered prediction's frozen
                    value, formula, or falsification condition may ever be modified (registry lock, QG193).
                </MudText>
            </MudCardContent>
        </MudCard>
    }
</div>

@code {
    [Inject] private ValidationDataService ValidationDataService { get; set; } = default!;

    private PredictionOutcomeFile? _outcomes;

    protected override async Task OnInitializedAsync()
    {
        _outcomes = await ValidationDataService.GetOutcomesAsync();
    }

    private static string StateClass(string? state) => state?.ToUpperInvariant() switch
    {
        "CONFIRMED" => "status-tested",
        "SUPPORTED" => "status-partial",
        "DISFAVORED" => "status-partial",
        "FALSIFIED" => "status-untested",
        _ => "status-pending",
    };
}
