@page "/theory"
@using MudBlazor
@using AT.App.Services

<PageTitle>Theory Book · AT</PageTitle>

<div class="hero theory-hero">
    <div class="hero-kicker">AT Theory Book</div>
    <div class="hero-title">The Actualization Theory</div>
    <div class="hero-subtitle">A Reconstruction of Physics from Difference, Actualization and Spectrum</div>
    <div class="hero-tagline">A structured theory book built from the minimal chain Difference → Actualization → Spectrum → Physics.</div>
    <div class="hero-stats">
        <div class="stat-tile"><div class="stat-value" style="color:#64B5F6">@TheoryBookDataService.Sections.Count</div><div class="stat-label">Parts</div></div>
        <div class="stat-tile"><div class="stat-value" style="color:#81C784">@TheoryBookDataService.Sections.Sum(s => s.Chapters.Count)</div><div class="stat-label">Chapters</div></div>
        <div class="stat-tile"><div class="stat-value" style="color:#FFB74D">4</div><div class="stat-label">Base layers</div></div>
        <div class="stat-tile"><div class="stat-value" style="color:#4DD0E1">1</div><div class="stat-label">Theory chain</div></div>
    </div>
</div>

<div class="page-section mt-3">
    <div class="theory-intro-strip">
        <MudText Typo="Typo.body2" Class="muted">
            Current reduction chain: Difference → Actualization → Spectrum → Physics. Use the cards below to jump
            into the relevant section, or open a full section from the overview.
        </MudText>
    </div>
</div>

<div class="page-section mt-4">
    <h2 class="section-heading">Table of Contents</h2>
    <MudGrid Spacing="3">
        @for (int i = 0; i < TheoryBookDataService.Sections.Count; i++)
        {
            var sec = TheoryBookDataService.Sections[i];
            var phaseIds = sec.Chapters.SelectMany(c => c.Results).SelectMany(r => r.PhaseIds).Distinct().Count();
            <MudItem xs="12" md="6" lg="4">
                <a href="@($"/theory/{sec.Slug}")" class="theory-toc-card-link">
                    <div class="theory-card theory-toc-card h-100">
                        <div class="theory-toc-num">@((i + 1).ToString("00"))</div>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold theory-toc-title">@sec.Title</MudText>
                        <MudText Typo="Typo.caption" Class="muted">
                            @sec.Chapters.Count chapters · @phaseIds phases
                        </MudText>
                        <MudText Typo="Typo.body2" Class="muted mt-2">@sec.Summary</MudText>
                    </div>
                </a>
            </MudItem>
        }
    </MudGrid>
</div>

<div class="page-section">
    <h2 class="section-heading">Badge Legend</h2>
    <div class="theory-legend-strip">
        <span class="badge badge-derived">DERIVED</span> closed argument chain from primitives
        &nbsp;&middot;&nbsp;
        <span class="badge badge-compatible">COMPATIBLE</span> representable without contradiction
        &nbsp;&middot;&nbsp;
        <span class="badge badge-postulated">POSTULATED</span> empirical input
        &nbsp;&middot;&nbsp;
        <span class="badge badge-partial">PARTIAL</span> analogy / organizing structure
        &nbsp;&middot;&nbsp;
        <span class="badge badge-match">MATCH</span> matches observation
        &nbsp;&middot;&nbsp;
        <span class="badge badge-preferred">PREFERRED</span> uniquely selected form
        &nbsp;&middot;&nbsp;
        <span class="badge badge-falsified">FALSIFIED</span> excluded by the network
    </div>
</div>
