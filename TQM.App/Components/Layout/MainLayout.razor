@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6">THE Q-MODEL</MudText>
        <MudSpacer />
        <MudLink Href="https://doi.org/10.5281/zenodo.20681734" Target="_blank" Underline="Underline.None" Class="top-nav-link mx-1" AriaLabel="Zenodo DOI">
            <MudImage Src="images/zenodo.20681734.svg" Alt="Zenodo DOI badge" Class="top-nav-badge" />
        </MudLink>
        <MudTooltip Text="https://github.com/MagusDraconis/TQM" Placement="Placement.Bottom" Arrow="true">
            <MudIconButton Href="https://github.com/MagusDraconis/TQM" Target="_blank" Icon="@Icons.Custom.Brands.GitHub" Color="Color.Primary" Class="top-nav-link" AriaLabel="GitHub repository" Size="Size.Medium" />
        </MudTooltip>
        <MudText Typo="Typo.caption" Class="hide-on-mobile muted">Research Atlas · v1.1</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Lg" Anchor="Anchor.Left" Elevation="1">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-5 px-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _isDark = true;
    private bool _drawerOpen = true;

    private static readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#64B5F6",
            Secondary = "#81C784",
            Tertiary = "#FFB74D",
            Background = "#0E1116",
            Surface = "#151A21",
            AppbarBackground = "#10141B",
            DrawerBackground = "#0C0F14",
            DrawerText = "#E6EDF3",
            DrawerIcon = "#8B949E",
            TextPrimary = "#E6EDF3",
            TextSecondary = "#8B949E"
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
