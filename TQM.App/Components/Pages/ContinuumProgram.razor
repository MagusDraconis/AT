@page "/continuum-program"

<PageTitle>Continuum Program · TQM</PageTitle>

<h2 class="section-heading">Continuum Program</h2>
<p class="muted">Two controlled continuum limits, disjoint in signature, plus the metric-origin chain.</p>

@foreach (var chain in AtlasDataService.ContinuumChains)
{
    <MudCard Elevation="1" Class="theory-card mb-3">
        <MudCardContent>
            <MudText Typo="Typo.subtitle1" Class="fw-bold">@chain.Title</MudText>
            <div class="mb-2" style="font-family:monospace;font-size:0.92rem;color:#64B5F6">@chain.Chain</div>
            <MudText Typo="Typo.body2"><strong>Status.</strong> @chain.Status</MudText>
            <MudText Typo="Typo.body2" Class="muted"><strong>Tests.</strong> @chain.Tests</MudText>
            <MudText Typo="Typo.body2" Class="muted"><strong>Limitations.</strong> @chain.Limitations</MudText>
        </MudCardContent>
    </MudCard>
}
