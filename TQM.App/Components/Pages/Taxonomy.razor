@page "/taxonomy"

<PageTitle>Taxonomy · TQM</PageTitle>

<h2 class="section-heading">Taxonomy</h2>
<p class="muted">The three-category taxonomy classifies underivability.</p>

<div class="mb-4">
    <span class="badge badge-derived">DERIVED</span> computable from the primitives by a theorem
    &nbsp;&middot;&nbsp;
    <span class="badge badge-real">REAL-UNDERIVED</span> real, precise, predictive, underivable
    &nbsp;&middot;&nbsp;
    <span class="badge badge-drawn">DRAWN</span> coincidental draw of the abundance law
</div>

<MudTable Items="AtlasDataService.Taxonomy" Hover="true" Dense="true">
    <HeaderContent>
        <MudTh>Object</MudTh>
        <MudTh>Classification</MudTh>
        <MudTh>Confidence</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd><ClassificationBadge Kind="@context.Kind" /></MudTd>
        <MudTd>@context.Confidence</MudTd>
    </RowTemplate>
</MudTable>
