@page "/validation"
@page "/validation/overview"
@layout ValidationLayout

<PageTitle>Validation Overview · TQM</PageTitle>

<div class="page-section">
    <h3 class="section-heading">Overview</h3>
    <p class="muted">Status of the full TQM-QG validation record, generated from the physics-coverage single source of truth and the immutable prediction registry.</p>

    @if (_coverage is null)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Medium" Class="mt-4" />
    }
    else
    {
        <div class="stat-row mb-4">
            <div class="stat-tile"><div class="stat-value" style="color:#81C784">@_coverage.Coverage.Tested</div><div class="stat-label">Tested phases</div></div>
            <div class="stat-tile"><div class="stat-value" style="color:#FFB74D">@_coverage.Coverage.Partial</div><div class="stat-label">Partial</div></div>
            <div class="stat-tile"><div class="stat-value" style="color:#4DD0E1">@_coverage.Coverage.Untested</div><div class="stat-label">Untested</div></div>
            <div class="stat-tile"><div class="stat-value" style="color:#BA68C8">@_coverage.Coverage.TotalPhases</div><div class="stat-label">Total phases</div></div>
            <div class="stat-tile"><div class="stat-value" style="color:#64B5F6">@(_coverage.Coverage.WeightedCoverage.ToString("P1", System.Globalization.CultureInfo.InvariantCulture))</div><div class="stat-label">Weighted coverage</div></div>
        </div>

        <MudCard Elevation="1" Class="theory-card mb-4">
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="muted">
                    Coverage is a <strong>validation status</strong>, not proof of correctness. A tested
                    classification means a D96 derivation reproduces the measured value; it records how much
                    of the measured information space the framework has reached. The validation section
                    presents blind reconstructions, anti-fit audits, the prediction registry, and per-domain
                    coverage — all from the machine-readable single source of truth.
                </MudText>
            </MudCardContent>
        </MudCard>

        <MudGrid Spacing="3">
            <MudItem xs="12" md="4">
                <MudCard Elevation="1" Class="theory-card h-100">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">Contradictions</MudText>
                        <MudText Typo="Typo.body2" Class="muted mt-2">
                            @(_contradictionCount) documented; @(_resolvedCount) resolved, @(_openContradictionCount) open/partial.
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Elevation="1" Class="theory-card h-100">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">Open questions</MudText>
                        <MudText Typo="Typo.body2" Class="muted mt-2">
                            @_openQuestionCount open items across domains.
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudCard Elevation="1" Class="theory-card h-100">
                    <MudCardContent>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">Registered predictions</MudText>
                        <MudText Typo="Typo.body2" Class="muted mt-2">
                            @_predictionCount immutable entries (@_registry?.LockedBy).
                        </MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <div class="page-section mt-4">
            <h3 class="section-heading">Sub-pages</h3>
            <ul class="audit-limits">
                <li><a href="/validation/blind-tests">Blind tests</a> — QG176 (Higgs hidden) and QG177 (12 observables leave-one-out): targets rebuilt from the primitive base only.</li>
                <li><a href="/validation/anti-fit">Anti-fit</a> — QG189 methodology audit: prediction vs blind vs dependent vs retro-fit vs overfit classification.</li>
                <li><a href="/validation/predictions">Predictions</a> — the immutable registry (P1 106 GeV, P2 0νββ, P3 sector-ladder) with frozen values and falsification conditions.</li>
                <li><a href="/validation/standard-model">Standard model</a> — per-observable coverage: tested / partial / untested.</li>
                <li><a href="/validation/gravity">Gravity</a> — GR-topic coverage: redshift, perihelion, G, Einstein structure, frame dragging, GPS, and open items.</li>
            </ul>
        </div>
    }
</div>

@code {
    [Inject] private ValidationDataService ValidationDataService { get; set; } = default!;

    private PhysicsCoverageFile? _coverage;
    private PredictionRegistryFile? _registry;

    private int _contradictionCount, _resolvedCount, _openContradictionCount, _openQuestionCount, _predictionCount;

    protected override async Task OnInitializedAsync()
    {
        _coverage = await ValidationDataService.GetCoverageAsync();
        _registry = await ValidationDataService.GetRegistryAsync();

        _contradictionCount = _coverage.Contradictions.Count;
        _resolvedCount = _coverage.Contradictions.Count(c => c.Status.Contains("RESOLVED"));
        _openContradictionCount = _contradictionCount - _resolvedCount;
        _openQuestionCount = _coverage.OpenQuestions.Count;
        _predictionCount = _registry.Predictions.Count;
    }
}
