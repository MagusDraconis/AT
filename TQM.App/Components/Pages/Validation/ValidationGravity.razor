@page "/validation/gravity"
@layout ValidationLayout

<PageTitle>Gravity · Validation · TQM</PageTitle>

<div class="page-section">
    <h3 class="section-heading">Gravity &amp; GR Validation</h3>
    <p class="muted">GR-topic coverage from the physics-coverage single source of truth — redshift, time dilation, GPS, Shapiro delay, light bending, perihelion, frame dragging, black holes, Hawking radiation, Newton constant, Einstein structure.</p>

    @if (_coverage is null)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Medium" Class="mt-4" />
    }
    else
    {
        <MudTable Items="@_topics" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>GR topic</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Phase</MudTh>
                <MudTh>Detail</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Topic</MudTd>
                <MudTd><span class="status-chip @StatusClass(context.Status)">@StatusLabel(context.Status)</span></MudTd>
                <MudTd><span class="audit-phase">@context.Phase</span></MudTd>
                <MudTd><span class="muted" style="font-size:0.8rem">@context.Detail</span></MudTd>
            </RowTemplate>
        </MudTable>

        <div class="page-section mt-4">
            <h3 class="section-heading">Contradictions</h3>
            <p class="muted">Documented tensions between phases and their resolution status.</p>

            <MudTable Items="@_contradictions" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>Topic</MudTh>
                    <MudTh>A</MudTh>
                    <MudTh>B</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd><span class="audit-phase">@context.Id</span></MudTd>
                    <MudTd>@context.Topic</MudTd>
                    <MudTd><span class="muted" style="font-size:0.8rem">@context.A</span></MudTd>
                    <MudTd><span class="muted" style="font-size:0.8rem">@context.B</span></MudTd>
                    <MudTd><span class="status-chip @ContradictionClass(context.Status)">@context.Status</span></MudTd>
                </RowTemplate>
            </MudTable>
        </div>

        <MudCard Elevation="1" Class="theory-card mt-4">
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="muted">
                    The GR observable chain is now closed: redshift, time dilation, GPS correction, perihelion,
                    frame dragging, Newton G, and the Einstein structure each have a completed phase. Light
                    bending and Shapiro delay remain partial (zero in the conformal ψ=0 sector; they require
                    the ψ tensor sector).
                </MudText>
            </MudCardContent>
        </MudCard>
    }
</div>

@code {
    [Inject] private ValidationDataService ValidationDataService { get; set; } = default!;

    private PhysicsCoverageFile? _coverage;
    private IReadOnlyList<GrTopicModel> _topics = [];
    private IReadOnlyList<ContradictionModel> _contradictions = [];

    protected override async Task OnInitializedAsync()
    {
        _coverage = await ValidationDataService.GetCoverageAsync();
        _topics = _coverage.GrTopics;
        _contradictions = _coverage.Contradictions;
    }

    private static string StatusClass(string status) => status switch
    {
        "tested" => "status-tested",
        "partial" => "status-partial",
        _ => "status-untested",
    };

    private static string StatusLabel(string status) => status switch
    {
        "tested" => "TESTED",
        "partial" => "PARTIAL",
        _ => "OPEN",
    };

    private static string ContradictionClass(string status) => status switch
    {
        "RESOLVED" => "status-tested",
        "PARTIALLY RESOLVED" => "status-partial",
        _ => "status-untested",
    };
}
