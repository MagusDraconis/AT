@page "/derivation-map"
@using TQM.App.Models
@using TQM.App.Services

<PageTitle>Theory Hierarchy · TQM</PageTitle>

<h2 class="section-heading">Theory Hierarchy</h2>
<p class="muted">
    Overview of the TQM derivation path from the base q-modes / Q-events to cosmology.
    This is a hierarchy map, not a phase-test graph.
</p>

<MudCard Elevation="1" Class="theory-card mb-4">
    <MudCardContent>
        <MudText Typo="Typo.body2" Class="muted">
            The map follows the theory book structure: base ontology, geometry, gravity, tensor sector,
            quantum sector, matter, gauge, and cosmology. Each stage shows the core formula or structural
            relation used in the current theory book.
        </MudText>
    </MudCardContent>
</MudCard>

<MudStack Spacing="2">
    @for (var i = 0; i < _stages.Count; i++)
    {
        var stage = _stages[i];
        <MudCard Elevation="1" Class="theory-card">
            <MudCardContent>
                <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                    <div>
                        <MudText Typo="Typo.caption" Class="text-uppercase fw-bold muted">
                            Step @((i + 1).ToString("00"))
                        </MudText>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">@stage.Title</MudText>
                        <MudText Typo="Typo.body2" Class="muted mt-2">@stage.Summary</MudText>
                    </div>

                    <div class="text-end">
                        <span class="badge badge-neutral">@stage.SectionTitle</span>
                        <div class="mt-2">
                            <span class="status-chip @BadgeClass(stage.Badge)">@stage.Badge.ToString().ToUpperInvariant()</span>
                        </div>
                    </div>
                </div>

                <div class="formula-block mt-3">@stage.Formula</div>

                @if (!string.IsNullOrWhiteSpace(stage.SectionSlug))
                {
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/theory/{stage.SectionSlug}")"
                               Class="mt-2 px-0" Size="Size.Small">
                        Open theory section <i class="bi bi-arrow-right"></i>
                    </MudButton>
                }
            </MudCardContent>
        </MudCard>

        @if (i < _stages.Count - 1)
        {
            <div class="text-center muted">
                <i class="bi bi-arrow-down"></i>
            </div>
        }
    }
</MudStack>

@code {
    private static readonly IReadOnlyList<HierarchyStage> _stages =
    [
        new(
            "Base (q-modes / Q-events)",
            "The primitive counting-measure layer: Q-events actualize the network and seed ρ.",
            "Q-events \u2192 ρ; ρ_k = μ^k/S; μ = 1 criticality",
            TQM.App.Models.TheoryBadge.Derived,
            "Introduction",
            "introduction"),
        new(
            "Causal order and spacetime",
            "From actualization to causal order and the emergent metric class.",
            "E1 < E2 iff E2 depends on E1; g = ρ^(2/d)\u03b7; sqrt(-g) = ρ",
            TQM.App.Models.TheoryBadge.Derived,
            "Network Ontology",
            "ontology"),
        new(
            "Gravity",
            "The conformal sector generates scalar gravity, regular cores, and rotation-curve behavior.",
            "a = -(1/d)\u2207ln ρ; GM_eff = m0r0/(d·\u03c1\u0304); M_eff(r)=M(1-e^(−r^3/r_c^3))",
            TQM.App.Models.TheoryBadge.Derived,
            "Gravity",
            "gravity"),
        new(
            "Tensor sector \u03c8",
            "The non-conformal Weyl content restores lensing, Shapiro delay, and spin-2 observables.",
            "g = ρ^(2/d)e^(2\u03c8); \u03b3 = +1 in the full sector; h_0i \u2260 0",
            TQM.App.Models.TheoryBadge.Partial,
            "Tensor Sector",
            "tensor"),
        new(
            "Quantum sector",
            "Link phases generate interference; actualization implements Born-weighted collapse.",
            "P = |\u03c8|^2; |e^(i\u03b8\u2081)+e^(i\u03b8\u2082)|^2 = 2+2cos(\u03b8\u2081-\u03b8\u2082)",
            TQM.App.Models.TheoryBadge.Partial,
            "Quantum Sector",
            "quantum"),
        new(
            "Matter sector",
            "Spin structure, fermions, families, and masses are represented through additional sector content.",
            "Spinor = section of a spin bundle; U(1) \u00d7 SU(2) \u00d7 SU(3); m_f = y_f·v",
            TQM.App.Models.TheoryBadge.Postulated,
            "Matter Sector",
            "matter"),
        new(
            "Gauge sector",
            "Charge, weak isospin, and color are hosted by distinct internal spaces.",
            "U(1) \u00d7 SU(2) \u00d7 SU(3); phase, spin, and color act on different spaces",
            TQM.App.Models.TheoryBadge.Postulated,
            "Gauge Sector",
            "gauge"),
        new(
            "Cosmology",
            "The same counting-measure picture extends to expansion, FRW compatibility, and dark-matter-like effects.",
            "a(t) = ρ^(1/d); \u039b(t) = \u03b1/\u221aV(t); g\u2020 = cH_0/(2\u03c0)",
            TQM.App.Models.TheoryBadge.Compatible,
            "Cosmology",
            "cosmology"),
    ];

    private static string BadgeClass(TQM.App.Models.TheoryBadge badge) => badge switch
    {
        TQM.App.Models.TheoryBadge.Derived => "badge-derived",
        TQM.App.Models.TheoryBadge.Compatible => "badge-compatible",
        TQM.App.Models.TheoryBadge.Postulated => "badge-postulated",
        TQM.App.Models.TheoryBadge.Partial => "badge-partial",
        TQM.App.Models.TheoryBadge.Match => "badge-match",
        TQM.App.Models.TheoryBadge.Preferred => "badge-preferred",
        TQM.App.Models.TheoryBadge.Falsified => "badge-falsified",
        _ => "badge-neutral",
    };

    private sealed record HierarchyStage(
        string Title,
        string Summary,
        string Formula,
        TQM.App.Models.TheoryBadge Badge,
        string SectionTitle,
        string SectionSlug);
}
