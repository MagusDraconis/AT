@page "/"

<PageTitle>TQM · Research Atlas</PageTitle>
@using TQM.App.Services
@inject ValidationDataService ValidationDataService

<div>
    <MudImage Src="/images/tqm-image1_web_small.jpg" Height="150" ObjectFit="ObjectFit.Cover" style="width:100%"/>
</div>

<div class="hero">
    <div class="hero-kicker">Research Atlas · v1.1</div>
    <div class="hero-title">THE Q-MODEL</div>
    <div class="hero-subtitle">From Q to Cosmology</div>
    <div class="hero-tagline">Structure is derivable. Content is realized.</div>

    <div class="hero-project-path">
        <a class="project-path-link" href="https://github.com/MagusDraconis/TQM" target="_blank" rel="noopener">github.com/MagusDraconis/TQM</a>
    </div>

    @if (_coverage is null)
    {
        <MudProgressCircular Indeterminate="true" Size="Size.Medium" Class="mt-4" />
    }
    else
    {
        <div class="hero-stats">
            <div class="stat-tile">
                <div class="stat-value" style="color:#4DD0E1">@_coverage.Coverage.TotalPhases</div>
                <div class="stat-label">TQM-QG Phases</div>
            </div>
            <div class="stat-tile">
                <div class="stat-value" style="color:#81C784">@_coverage.Coverage.Tested</div>
                <div class="stat-label">Tested</div>
            </div>
            <div class="stat-tile">
                <div class="stat-value" style="color:#FFB74D">@_coverage.Coverage.Partial</div>
                <div class="stat-label">Partial</div>
            </div>
            <div class="stat-tile">
                <div class="stat-value" style="color:#64B5F6">@(_coverage.Coverage.WeightedCoverage.ToString("P1", System.Globalization.CultureInfo.InvariantCulture))</div>
                <div class="stat-label">Weighted coverage</div>
            </div>
        </div>

        <div class="hero-chain">
            @for (int i = 0; i < AtlasDataService.HeroChain.Count; i++)
            {
                <span class="chain-node">@AtlasDataService.HeroChain[i]</span>
                @if (i < AtlasDataService.HeroChain.Count - 1)
                {
                    <span class="chain-arrow">&rarr;</span>
                }
            }
        </div>
    }
</div>

<div class="page-section mt-4">
    <h2 class="section-heading">Why TQM?</h2>
    <div class="why-grid">
        @foreach (var q in AtlasDataService.WhyQuestions)
        {
            <div class="why-tile"><span class="q">@q</span></div>
        }
    </div>
    <p class="mt-2">
        TQM investigates whether observable physics can emerge from a smaller primitive foundation.
        <a href="/story">Read the full story &rarr;</a>
    </p>
</div>

<div class="page-section">
    <h2 class="section-heading">Recent Findings</h2>
    <p class="muted">The latest TQM-QG results (phases 203–209): the standard-model derivations are now closed-form D96 laws.</p>
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" lg="4">
            <MudCard Elevation="1" Class="theory-card h-100">
                <MudCardContent>
                    <MudText Typo="Typo.caption" Class="text-uppercase fw-bold muted">QG203 · ABSOLUTE MASS ORIGIN</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mt-1">Exact neutrino masses</MudText>
                    <MudText Typo="Typo.body2" Class="muted mt-2">
                        m1 = 0, m2 = 1/(Σ√m·√(span/2)) = 8.72 meV, m3 = √#g/(Σm·√2) = 49.4 meV.
                        Closed-form D96 expressions; ratio m2/m3 = 2Σm/(Σ√m·√(span·#g)) exact.
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" lg="4">
            <MudCard Elevation="1" Class="theory-card h-100">
                <MudCardContent>
                    <MudText Typo="Typo.caption" Class="text-uppercase fw-bold muted">QG204 · RUNNING ORIGIN</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mt-1">Quark MS̄ running</MudText>
                    <MudText Typo="Typo.body2" Class="muted mt-2">
                        The D96 mass law is natively MS̄ at the natural scale (all six within 0.2%);
                        spectral α_s = 8/Σ√m; exponent q = #d/(2·#g) reproduces the QCD ratio.
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" lg="4">
            <MudCard Elevation="1" Class="theory-card h-100">
                <MudCardContent>
                    <MudText Typo="Typo.caption" Class="text-uppercase fw-bold muted">QG206–208 · GRAVITY CLOSURE</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mt-1">α=0, metric ansatz, Hawking</MudText>
                    <MudText Typo="Typo.body2" Class="muted mt-2">
                        α = 0 derived (flat rotation curves are the scale-free deficit); metric ansatz
                        PARTIAL UNIQUE; Hawking T ∝ 1/R preserved in the ψ sector.
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" lg="4">
            <MudCard Elevation="1" Class="theory-card h-100">
                <MudCardContent>
                    <MudText Typo="Typo.caption" Class="text-uppercase fw-bold muted">QG209 · EXACT LAW</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold mt-1">Lepton hierarchy</MudText>
                    <MudText Typo="Typo.body2" Class="muted mt-2">
                        m_μ = me·Σm²/√occMom, m_τ = me·Σm²·λ₂. Exact D96 ratios, no empirical
                        exponents: m_μ 0.13%, m_τ 0.28%.
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</div>

<div class="page-section">
    <h2 class="section-heading">Research Journey</h2>
    <div class="story-flow">
        @for (int i = 0; i < AtlasDataService.StoryChapters.Count; i++)
        {
            <span class="@($"badge tone-{AtlasDataService.StoryChapters[i].Tone}")"><i class="@($"bi {AtlasDataService.StoryChapters[i].Icon}")"></i>&nbsp;@AtlasDataService.StoryChapters[i].Era</span>
            @if (i < AtlasDataService.StoryChapters.Count - 1)
            {
                <span class="chain-arrow">&darr;</span>
            }
        }
    </div>
    <p class="muted mt-2">TRM &rarr; Problems Found &rarr; ResearchX &rarr; Structure/Content Split &rarr; Hostile Reviews &rarr; TQM v1.0 &rarr; D96 Program &rarr; QG209.</p>
</div>

<div class="page-section">
    <h2 class="section-heading">From TRM to TQM</h2>
    <MudCard Elevation="1" Class="theory-card">
        <MudCardContent>
            <MudText Typo="Typo.body2" Class="muted">
                TQM's predecessor, the Temporal Resonance Model, assembled striking pieces but carried zero
                candidate physics. The legacy audit absorbed three modules, rejected two, and kept three as
                candidate mathematics. TQM re-derived the surviving structure from two primitives plus one number.
            </MudText>
        </MudCardContent>
    </MudCard>
</div>

<div class="page-section">
    <h2 class="section-heading">Key Discoveries</h2>
    <MudGrid Spacing="3">
        @foreach (var d in AtlasDataService.KeyDiscoveries)
        {
            <MudItem xs="12" sm="6" lg="4">
                <TheoryCard Title="@d.Title">
                    <ClassificationBadge Kind="@d.Kind" />
                    <MudText Typo="Typo.body2" Class="muted mt-2">@d.Description</MudText>
                </TheoryCard>
            </MudItem>
        }
    </MudGrid>
</div>

<div class="page-section">
    <h2 class="section-heading">Prediction Status</h2>
    <MudCard Elevation="1" Class="theory-card">
        <MudCardContent>
            @if (_outcomes is null)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            }
            else
            {
                <MudText Typo="Typo.body2" Class="muted">
                    The three pre-registered predictions (P1 106 GeV, P2 0νββ 2.02 meV, P3 sector-ladder)
                    are immutable. Current states:
                    <span class="status-chip status-pending">P1 PENDING</span>
                    <span class="status-chip status-pending">P2 PENDING</span>
                    <span class="status-chip status-partial">P3 SUPPORTED</span>
                    &nbsp;(151.98 rung = ~152 GeV excess)
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/validation/prediction-status" Class="mt-2">
                    Prediction status
                </MudButton>
            }
        </MudCardContent>
    </MudCard>
</div>

<div class="page-section">
    <div class="mb-2">
        <span class="badge badge-derived">DERIVED</span>
        <span class="badge badge-real">REAL-UNDERIVED</span>
        <span class="badge badge-drawn">DRAWN</span>
        <span class="muted">&mdash; the taxonomy used throughout this atlas.</span>
    </div>
</div>

@code {
    private PhysicsCoverageFile? _coverage;
    private PredictionOutcomeFile? _outcomes;

    protected override async Task OnInitializedAsync()
    {
        _coverage = await ValidationDataService.GetCoverageAsync();
        _outcomes = await ValidationDataService.GetOutcomesAsync();
    }
}


