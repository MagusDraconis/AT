@namespace TQM.App.Components.Shared
@using TQM.App.Models

<div class="test-dashboard">
    <div class="stat-row mb-4">
        <div class="stat-tile"><div class="stat-value">@TotalSuites</div><div class="stat-label">Test Suites</div></div>
        <div class="stat-tile"><div class="stat-value" style="color:#81C784">@TotalPass</div><div class="stat-label">PASS</div></div>
        <div class="stat-tile"><div class="stat-value" style="color:#E57373">@TotalFail</div><div class="stat-label">FAIL</div></div>
    </div>

    @foreach (var group in Groups)
    {
        <MudText Typo="Typo.subtitle2" Class="text-uppercase fw-bold mt-4 mb-1">@group.Name</MudText>
        <MudTable Items="group.Suites" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>Test file</MudTh>
                <MudTh>Tests</MudTh>
                <MudTh>Result</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Tests</MudTd>
                <MudTd><StatusBadge Status="@context.Result" /></MudTd>
            </RowTemplate>
        </MudTable>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TestGroupModel> Groups { get; set; } = [];

    private int TotalSuites => Groups.Sum(g => g.Suites.Count);
    private int TotalPass => Groups.Sum(g => g.Suites.Count(s => s.Result is "PASS" or "PASSED"));
    private int TotalFail => Groups.Sum(g => g.Suites.Count(s => s.Result is "FAIL"));
}
