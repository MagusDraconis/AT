{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "TQM.App — Blazor Server",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/TQM.App/TQM.App.csproj",
            "launchSettingsProfile": "http"
        },
        {
            "name": "TQM.App — Blazor Server (coreclr)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/TQM.App/bin/Debug/net10.0/TQM.App.dll",
            "args": [],
            "cwd": "${workspaceFolder}/TQM.App",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5198"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            }
        },
        {
            "name": "Launch Chrome against localhost",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5198",
            "webRoot": "${workspaceFolder}"
        }
    ]
}